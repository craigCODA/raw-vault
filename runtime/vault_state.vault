      "nodes": {
        "s001": {"op": "Assign", "targets": [{"store": "save"}], "value": {"op": "Call", "func": {"body": "body/vault_state/load_save"}, "args": [{"name": "args"}, {"name": "context"}]}},
        "s002": {"op": "Assign", "targets": [{"store": "branches"}], "value": {"op": "DictComp", "key": {"name": "name"}, "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "context"}, "attr": "run"}, "args": [{"op": "Subscript", "value": {"name": "parameters"}, "slice": {"const": "resume"}}, {"op": "Call", "func": {"body": "body/vault_state/branch_arguments"}, "args": [{"name": "args"}, {"name": "save"}, {"name": "event"}]}]}, "generators": [{"op": "comprehension", "target": {"op": "Tuple", "elts": [{"store": "name"}, {"store": "event"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"op": "Subscript", "value": {"name": "args"}, "slice": {"const": "branches"}}, "attr": "items"}}, "is_async": 0}]}},
        "s003": {"op": "Return", "value": {"op": "Dict", "keys": [{"const": "save"}, {"const": "branches"}], "values": [{"name": "save"}, {"name": "branches"}]}}
