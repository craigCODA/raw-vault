        "s012": {"op": "Assign", "targets": [{"op": "Subscript", "value": {"name": "refined"}, "slice": {"name": "state"}, "ctx": {"op": "Store"}}], "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "classes"}, "attr": "setdefault"}, "args": [{"name": "signature"}, {"name": "state"}]}},
        "s013": {"op": "If", "test": {"op": "Compare", "left": {"name": "refined"}, "ops": [{"op": "Eq"}], "comparators": [{"name": "representatives"}]}, "body": [{"step": "s014"}]},
        "s014": {"op": "Return", "value": {"op": "Dict", "keys": [{"const": "representatives"}, {"const": "shared_count"}], "values": [{"name": "refined"}, {"op": "Call", "func": {"name": "len"}, "args": [{"name": "classes"}]}]}},
