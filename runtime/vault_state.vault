        "s010": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "state"}, {"store": "transitions"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"name": "sorted"}, "args": [{"op": "Call", "func": {"op": "Attribute", "value": {"name": "states"}, "attr": "items"}}]}, "body": [{"step": "s011"}, {"step": "s012"}]},
