{
  "format": "vault-body-graph/1",
  "module": "vault_state",
  "exports": ["branching_saves", "compact_decision_tables", "competing_viewpoints", "computed_capabilities", "context_lifetimes", "disk_locality", "identity_through_state_changes", "measure_the_work", "new_word_existing_operation", "one_changed_variable", "physical_triggers", "restore_and_replay", "resume_addresses", "same_words_different_save", "shared_states", "state_differences"],
  "bodies": {
    "canonical": {
      "parameters": ["value"],
      "entry": ["s001"],
      "nodes": {
        "s001": {"op": "Return", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "json"}, "attr": "dumps"}, "args": [{"name": "value"}], "keywords": [{"op": "keyword", "arg": "ensure_ascii", "value": {"const": false}}, {"op": "keyword", "arg": "sort_keys", "value": {"const": true}}, {"op": "keyword", "arg": "separators", "value": {"op": "Tuple", "elts": [{"const": ","}, {"const": ":"}]}}, {"op": "keyword", "arg": "allow_nan", "value": {"const": false}}]}}
      }
    },
    "load_save": {
      "parameters": ["args", "context"],
      "entry": ["s001", "s003", "s004", "s006"],
      "nodes": {
        "s001": {"op": "If", "test": {"op": "BoolOp", "operator": {"op": "And"}, "values": [{"op": "Compare", "left": {"const": "save_file"}, "ops": [{"op": "In"}], "comparators": [{"name": "args"}]}, {"op": "Compare", "left": {"const": "save"}, "ops": [{"op": "In"}], "comparators": [{"name": "args"}]}]}, "body": [{"step": "s002"}]},
        "s002": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"const": "Supply one saved state."}]}},
        "s003": {"op": "Assign", "targets": [{"store": "save"}], "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "args"}, "attr": "get"}, "args": [{"const": "save_file"}, {"op": "Call", "func": {"op": "Attribute", "value": {"name": "args"}, "attr": "get"}, "args": [{"const": "save"}, {"name": "args"}]}]}},
        "s004": {"op": "If", "test": {"op": "Call", "func": {"name": "isinstance"}, "args": [{"name": "save"}, {"name": "str"}]}, "body": [{"step": "s005"}]},
        "s005": {"op": "Assign", "targets": [{"store": "save"}], "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "json"}, "attr": "loads"}, "args": [{"op": "Call", "func": {"op": "Attribute", "value": {"name": "context"}, "attr": "read_asset"}, "args": [{"name": "save"}]}]}},
        "s006": {"op": "Return", "value": {"op": "Dict", "keys": [{"const": "state"}, {"const": "cursor"}], "values": [{"op": "Call", "func": {"name": "deepcopy"}, "args": [{"op": "Subscript", "value": {"name": "save"}, "slice": {"const": "state"}}]}, {"op": "Subscript", "value": {"name": "save"}, "slice": {"const": "cursor"}}]}}
      }
    },
    "resume_addresses": {
      "parameters": ["args", "parameters", "context"],
      "entry": ["s001", "s002"],
      "nodes": {
        "s001": {"op": "Assign", "targets": [{"store": "options"}], "value": {"op": "DictComp", "key": {"name": "key"}, "value": {"op": "Subscript", "value": {"name": "args"}, "slice": {"name": "key"}}, "generators": [{"op": "comprehension", "target": {"store": "key"}, "iter": {"op": "Tuple", "elts": [{"const": "links"}, {"const": "event"}, {"const": "max_steps"}, {"const": "c"}]}, "ifs": [{"op": "Compare", "left": {"name": "key"}, "ops": [{"op": "In"}], "comparators": [{"name": "args"}]}], "is_async": 0}]}},
        "s002": {"op": "Return", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "context"}, "attr": "run"}, "args": [{"op": "Subscript", "value": {"name": "parameters"}, "slice": {"const": "execution"}}, {"op": "BinOp", "left": {"op": "Call", "func": {"body": "body/vault_state/load_save"}, "args": [{"name": "args"}, {"name": "context"}]}, "operator": {"op": "BitOr"}, "right": {"name": "options"}}]}}
      }
    },
    "state_differences": {
      "parameters": ["args", "_parameters", "_context"],
      "entry": ["s001", "s002", "s003", "s004", "s005", "s007"],
      "nodes": {
        "s001": {"op": "Assign", "targets": [{"op": "Tuple", "elts": [{"store": "before"}, {"store": "after"}], "ctx": {"op": "Store"}}], "value": {"op": "Tuple", "elts": [{"op": "Subscript", "value": {"name": "args"}, "slice": {"const": "before"}}, {"op": "Subscript", "value": {"name": "args"}, "slice": {"const": "after"}}]}},
        "s002": {"op": "Assign", "targets": [{"store": "changed"}], "value": {"op": "DictComp", "key": {"name": "key"}, "value": {"name": "value"}, "generators": [{"op": "comprehension", "target": {"op": "Tuple", "elts": [{"store": "key"}, {"store": "value"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "after"}, "attr": "items"}}, "ifs": [{"op": "BoolOp", "operator": {"op": "Or"}, "values": [{"op": "Compare", "left": {"name": "key"}, "ops": [{"op": "NotIn"}], "comparators": [{"name": "before"}]}, {"op": "Compare", "left": {"op": "Call", "func": {"body": "body/vault_state/canonical"}, "args": [{"op": "Subscript", "value": {"name": "before"}, "slice": {"name": "key"}}]}, "ops": [{"op": "NotEq"}], "comparators": [{"op": "Call", "func": {"body": "body/vault_state/canonical"}, "args": [{"name": "value"}]}]}]}], "is_async": 0}]}},
        "s003": {"op": "Assign", "targets": [{"store": "deleted"}], "value": {"op": "Call", "func": {"name": "sorted"}, "args": [{"op": "BinOp", "left": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "before"}, "attr": "keys"}}, "operator": {"op": "Sub"}, "right": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "after"}, "attr": "keys"}}}]}},
        "s004": {"op": "Assign", "targets": [{"store": "restored"}], "value": {"op": "BinOp", "left": {"name": "before"}, "operator": {"op": "BitOr"}, "right": {"name": "changed"}}},
        "s005": {"op": "For", "target": {"store": "key"}, "iter": {"name": "deleted"}, "body": [{"step": "s006"}]},
        "s006": {"op": "Delete", "targets": [{"op": "Subscript", "value": {"name": "restored"}, "slice": {"name": "key"}, "ctx": {"op": "Del"}}]},
        "s007": {"op": "Return", "value": {"op": "Dict", "keys": [{"const": "difference"}, {"const": "state"}, {"const": "matches_after"}], "values": [{"op": "Dict", "keys": [{"const": "changed"}, {"const": "deleted"}], "values": [{"name": "changed"}, {"name": "deleted"}]}, {"name": "restored"}, {"op": "Compare", "left": {"op": "Call", "func": {"body": "body/vault_state/canonical"}, "args": [{"name": "restored"}]}, "ops": [{"op": "Eq"}], "comparators": [{"op": "Call", "func": {"body": "body/vault_state/canonical"}, "args": [{"name": "after"}]}]}]}}
