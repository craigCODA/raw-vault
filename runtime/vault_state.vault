    "shared_states": {
      "parameters": ["args", "_parameters", "_context"],
      "entry": ["s001", "s002", "s006", "s007"],
      "nodes": {
        "s001": {"op": "Assign", "targets": [{"op": "Tuple", "elts": [{"store": "events"}, {"store": "states"}], "ctx": {"op": "Store"}}], "value": {"op": "Tuple", "elts": [{"op": "Subscript", "value": {"name": "args"}, "slice": {"const": "events"}}, {"op": "Subscript", "value": {"name": "args"}, "slice": {"const": "states"}}]}},
        "s002": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "state"}, {"store": "transitions"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "states"}, "attr": "items"}}, "body": [{"step": "s003"}]},
        "s003": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "event"}, {"store": "route"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "transitions"}, "attr": "items"}}, "body": [{"step": "s004"}]},
        "s004": {"op": "If", "test": {"op": "BoolOp", "operator": {"op": "Or"}, "values": [{"op": "Compare", "left": {"name": "event"}, "ops": [{"op": "NotIn"}], "comparators": [{"name": "events"}]}, {"op": "Compare", "left": {"op": "Subscript", "value": {"name": "route"}, "slice": {"const": "next"}}, "ops": [{"op": "NotIn"}], "comparators": [{"name": "states"}]}]}, "body": [{"step": "s005"}]},
        "s005": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"op": "JoinedStr", "values": [{"const": "Undeclared event or successor at state "}, {"op": "FormattedValue", "value": {"name": "state"}, "conversion": 114}, {"const": "."}]}]}},
        "s006": {"op": "Assign", "targets": [{"store": "representatives"}], "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "dict"}, "attr": "fromkeys"}, "args": [{"name": "states"}]}},
        "s007": {"op": "While", "test": {"const": true}, "body": [{"step": "s008"}, {"step": "s009"}, {"step": "s010"}, {"step": "s013"}, {"step": "s015"}]},
