{
  "format": "vault-body-graph/1",
  "module": "vault_reasoning",
  "exports": [],
  "bodies": {
    "fact_key": {
      "parameters": ["fact"],
      "entry": ["s001"],
      "nodes": {
        "s001": {"op": "Return", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "json"}, "attr": "dumps"}, "args": [{"name": "fact"}], "keywords": [{"op": "keyword", "arg": "ensure_ascii", "value": {"const": false}}, {"op": "keyword", "arg": "separators", "value": {"op": "Tuple", "elts": [{"const": ","}, {"const": ":"}]}}]}}
      }
    },
    "opposite": {
      "parameters": ["fact"],
      "entry": ["s001", "s003"],
      "nodes": {
        "s001": {"op": "If", "test": {"op": "Compare", "left": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 0}}, "ops": [{"op": "Eq"}], "comparators": [{"name": "NEGATION"}]}, "body": [{"step": "s002"}]},
        "s002": {"op": "Return", "value": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 1}}},
        "s003": {"op": "Return", "value": {"op": "List", "elts": [{"name": "NEGATION"}, {"name": "fact"}]}}
      }
    },
    "fact_variables": {
      "parameters": ["fact", "allow_negation"],
      "defaults": [true],
      "entry": ["s001", "s003", "s007", "s009"],
      "nodes": {
        "s001": {"op": "If", "test": {"op": "BoolOp", "operator": {"op": "Or"}, "values": [{"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"op": "Call", "func": {"name": "isinstance"}, "args": [{"name": "fact"}, {"name": "list"}]}}, {"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"name": "fact"}}, {"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"op": "Call", "func": {"name": "isinstance"}, "args": [{"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 0}}, {"name": "str"}]}}, {"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 0}}}, {"op": "Call", "func": {"op": "Attribute", "value": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 0}}, "attr": "startswith"}, "args": [{"const": "$"}]}]}, "body": [{"step": "s002"}]},
        "s002": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"const": "A fact needs a fixed predicate followed by its arguments."}]}},
        "s003": {"op": "If", "test": {"op": "Compare", "left": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 0}}, "ops": [{"op": "Eq"}], "comparators": [{"name": "NEGATION"}]}, "body": [{"step": "s004"}, {"step": "s006"}]},
        "s004": {"op": "If", "test": {"op": "BoolOp", "operator": {"op": "Or"}, "values": [{"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"name": "allow_negation"}}, {"op": "Compare", "left": {"op": "Call", "func": {"name": "len"}, "args": [{"name": "fact"}]}, "ops": [{"op": "NotEq"}], "comparators": [{"const": 2}]}]}, "body": [{"step": "s005"}]},
        "s005": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"const": "Explicit negation takes a single positive fact."}]}},
        "s006": {"op": "Return", "value": {"op": "Call", "func": {"body": "body/vault_reasoning/fact_variables"}, "args": [{"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 1}}], "keywords": [{"op": "keyword", "arg": "allow_negation", "value": {"const": false}}]}},
        "s007": {"op": "If", "test": {"op": "Call", "func": {"name": "any"}, "args": [{"op": "GeneratorExp", "elt": {"op": "Compare", "left": {"op": "Call", "func": {"name": "type"}, "args": [{"name": "value"}]}, "ops": [{"op": "NotIn"}], "comparators": [{"op": "Tuple", "elts": [{"name": "str"}, {"name": "int"}, {"name": "float"}]}]}, "generators": [{"op": "comprehension", "target": {"store": "value"}, "iter": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"op": "Slice", "lower": {"const": 1}}}, "is_async": 0}]}]}, "body": [{"step": "s008"}]},
        "s008": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"const": "Fact arguments must be strings or numbers."}]}},
        "s009": {"op": "Return", "value": {"op": "SetComp", "elt": {"name": "value"}, "generators": [{"op": "comprehension", "target": {"store": "value"}, "iter": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"op": "Slice", "lower": {"const": 1}}}, "ifs": [{"op": "BoolOp", "operator": {"op": "And"}, "values": [{"op": "Call", "func": {"name": "isinstance"}, "args": [{"name": "value"}, {"name": "str"}]}, {"op": "Call", "func": {"op": "Attribute", "value": {"name": "value"}, "attr": "startswith"}, "args": [{"const": "$"}]}]}], "is_async": 0}]}}
      }
    },
    "prepare_defaults": {
      "parameters": ["rules"],
