        "s008": {"op": "Expr", "value": {"op": "YieldFrom", "value": {"op": "Call", "func": {"body": "body/vault_reasoning/match_premises"}, "args": [{"name": "remaining"}, {"name": "available"}, {"name": "matched"}, {"op": "List", "elts": [{"op": "Starred", "value": {"name": "premises"}}, {"name": "fact"}]}]}}}
