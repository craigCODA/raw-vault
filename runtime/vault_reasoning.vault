        "s005": {"op": "For", "target": {"store": "fact"}, "iter": {"op": "Subscript", "value": {"name": "available"}, "slice": {"op": "Subscript", "value": {"name": "pattern"}, "slice": {"const": 0}}}, "body": [{"step": "s006"}, {"step": "s007"}]},
