        "s009": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "left"}, {"store": "comparison"}, {"store": "right"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "rule"}, "attr": "get"}, "args": [{"const": "checks"}, {"op": "List"}]}, "body": [{"step": "s010"}, {"step": "s012"}, {"step": "s013"}, {"step": "s014"}]},
        "s010": {"op": "If", "test": {"op": "Compare", "left": {"name": "comparison"}, "ops": [{"op": "NotIn"}], "comparators": [{"name": "COMMON_COMPARISONS"}]}, "body": [{"step": "s011"}]},
        "s011": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"op": "JoinedStr", "values": [{"const": "Unknown comparison "}, {"op": "FormattedValue", "value": {"name": "comparison"}, "conversion": 114}]}]}},
        "s012": {"op": "Assign", "targets": [{"op": "Tuple", "elts": [{"store": "a"}, {"store": "b"}], "ctx": {"op": "Store"}}], "value": {"op": "Tuple", "elts": [{"op": "Call", "func": {"name": "compile_value"}, "args": [{"name": "left"}]}, {"op": "Call", "func": {"name": "compile_value"}, "args": [{"name": "right"}]}]}},
        "s013": {"op": "Expr", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "output"}, "attr": "update"}, "args": [{"op": "GeneratorExp", "elt": {"op": "BinOp", "left": {"const": "$"}, "operator": {"op": "Add"}, "right": {"name": "name"}}, "generators": [{"op": "comprehension", "target": {"store": "name"}, "iter": {"op": "Tuple", "elts": [{"op": "Starred", "value": {"op": "Attribute", "value": {"name": "a"}, "attr": "inputs"}}, {"op": "Starred", "value": {"op": "Attribute", "value": {"name": "b"}, "attr": "inputs"}}]}, "is_async": 0}]}]}},
        "s014": {"op": "Expr", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "checks"}, "attr": "append"}, "args": [{"op": "Tuple", "elts": [{"name": "a"}, {"name": "comparison"}, {"name": "b"}]}]}},
        "s015": {"op": "If", "test": {"op": "BinOp", "left": {"op": "BinOp", "left": {"name": "output"}, "operator": {"op": "BitOr"}, "right": {"name": "exceptions"}}, "operator": {"op": "Sub"}, "right": {"name": "bound"}}, "body": [{"step": "s016"}]},
        "s016": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"op": "JoinedStr", "values": [{"const": "Default "}, {"op": "FormattedValue", "value": {"name": "name"}, "conversion": 114}, {"const": " refers to variables outside its premises."}]}]}},
        "s017": {"op": "Expr", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "defaults"}, "attr": "append"}, "args": [{"op": "Tuple", "elts": [{"name": "name"}, {"name": "rule"}, {"name": "checks"}]}]}},
