        "s010": {"op": "Assign", "targets": [{"store": "defaults"}], "value": {"op": "Call", "func": {"body": "body/vault_reasoning/prepare_defaults"}, "args": [{"name": "rules"}]}},
        "s011": {"op": "While", "test": {"const": true}, "body": [{"step": "s012"}, {"step": "s013"}, {"step": "s015"}, {"step": "s016"}, {"step": "s033"}, {"step": "s035"}]},
        "s012": {"op": "Assign", "targets": [{"store": "available"}], "value": {"op": "Call", "func": {"name": "defaultdict"}, "args": [{"name": "list"}]}},
        "s013": {"op": "For", "target": {"store": "fact"}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "known"}, "attr": "values"}}, "body": [{"step": "s014"}]},
        "s014": {"op": "Expr", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"op": "Subscript", "value": {"name": "available"}, "slice": {"op": "Subscript", "value": {"name": "fact"}, "slice": {"const": 0}}}, "attr": "append"}, "args": [{"name": "fact"}]}},
        "s015": {"op": "Assign", "targets": [{"store": "pending"}], "value": {"op": "Dict"}},
        "s016": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "name"}, {"store": "rule"}, {"store": "checks"}], "ctx": {"op": "Store"}}, "iter": {"name": "defaults"}, "body": [{"step": "s017"}]},
        "s017": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "bindings"}, {"store": "premises"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"body": "body/vault_reasoning/match_premises"}, "args": [{"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "when"}}, {"name": "available"}, {"op": "Dict"}, {"op": "List"}]}, "body": [{"step": "s018"}, {"step": "s019"}, {"step": "s020"}, {"step": "s022"}, {"step": "s023"}, {"step": "s025"}, {"step": "s026"}, {"step": "s027"}, {"step": "s028"}, {"step": "s031"}, {"step": "s032"}]},
        "s018": {"op": "Assign", "targets": [{"store": "fact"}], "value": {"op": "Call", "func": {"body": "body/vault_reasoning/instantiate"}, "args": [{"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "expect"}}, {"name": "bindings"}]}},
        "s019": {"op": "Assign", "targets": [{"store": "key"}], "value": {"op": "Call", "func": {"body": "body/vault_reasoning/fact_key"}, "args": [{"name": "fact"}]}},
        "s020": {"op": "If", "test": {"op": "BoolOp", "operator": {"op": "Or"}, "values": [{"op": "Compare", "left": {"name": "key"}, "ops": [{"op": "In"}], "comparators": [{"name": "known"}]}, {"op": "Compare", "left": {"name": "key"}, "ops": [{"op": "In"}], "comparators": [{"name": "pending"}]}]}, "body": [{"step": "s021"}]},
        "s021": {"op": "Continue"},
        "s022": {"op": "Assign", "targets": [{"store": "decisions"}], "value": {"op": "ListComp", "elt": {"op": "Call", "func": {"body": "body/vault_reasoning/run_check"}, "args": [{"name": "check"}, {"name": "bindings"}]}, "generators": [{"op": "comprehension", "target": {"store": "check"}, "iter": {"name": "checks"}, "is_async": 0}]}},
        "s023": {"op": "If", "test": {"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"op": "Call", "func": {"name": "all"}, "args": [{"op": "GeneratorExp", "elt": {"op": "Subscript", "value": {"name": "check"}, "slice": {"const": "holds"}}, "generators": [{"op": "comprehension", "target": {"store": "check"}, "iter": {"name": "decisions"}, "is_async": 0}]}]}}, "body": [{"step": "s024"}]},
        "s024": {"op": "Continue"},
        "s025": {"op": "Assign", "targets": [{"store": "blockers"}], "value": {"op": "List", "elts": [{"op": "Call", "func": {"body": "body/vault_reasoning/opposite"}, "args": [{"name": "fact"}]}, {"op": "Starred", "value": {"op": "GeneratorExp", "elt": {"op": "Call", "func": {"body": "body/vault_reasoning/instantiate"}, "args": [{"name": "p"}, {"name": "bindings"}]}, "generators": [{"op": "comprehension", "target": {"store": "p"}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "rule"}, "attr": "get"}, "args": [{"const": "unless"}, {"op": "List"}]}, "is_async": 0}]}}]}},
        "s026": {"op": "Assign", "targets": [{"store": "blocker"}], "value": {"op": "Call", "func": {"name": "next"}, "args": [{"op": "GeneratorExp", "elt": {"name": "item"}, "generators": [{"op": "comprehension", "target": {"store": "item"}, "iter": {"name": "blockers"}, "ifs": [{"op": "Compare", "left": {"op": "Call", "func": {"body": "body/vault_reasoning/fact_key"}, "args": [{"name": "item"}]}, "ops": [{"op": "In"}], "comparators": [{"name": "observed"}]}], "is_async": 0}]}, {"const": null}]}},
        "s027": {"op": "Assign", "targets": [{"store": "step"}], "value": {"op": "Dict", "keys": [{"const": "fact"}, {"const": "rule"}, {"const": "relation"}, {"const": "premises"}, {"const": "checks"}], "values": [{"name": "fact"}, {"name": "name"}, {"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "relation"}}, {"name": "premises"}, {"name": "decisions"}]}},
        "s028": {"op": "If", "test": {"op": "Compare", "left": {"name": "blocker"}, "ops": [{"op": "IsNot"}], "comparators": [{"const": null}]}, "body": [{"step": "s029"}, {"step": "s030"}]},
        "s029": {"op": "Assign", "targets": [{"op": "Subscript", "value": {"name": "blocked"}, "slice": {"op": "Tuple", "elts": [{"name": "name"}, {"name": "key"}, {"op": "Call", "func": {"body": "body/vault_reasoning/fact_key"}, "args": [{"name": "blocker"}]}]}, "ctx": {"op": "Store"}}], "value": {"op": "BinOp", "left": {"name": "step"}, "operator": {"op": "BitOr"}, "right": {"op": "Dict", "keys": [{"const": "by"}], "values": [{"name": "blocker"}]}}},
