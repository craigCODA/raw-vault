      "nodes": {
        "s001": {"op": "Assign", "targets": [{"store": "defaults"}], "value": {"op": "List"}},
        "s002": {"op": "For", "target": {"op": "Tuple", "elts": [{"store": "name"}, {"store": "rule"}], "ctx": {"op": "Store"}}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "rules"}, "attr": "get"}, "args": [{"const": "defaults"}, {"op": "Dict"}]}, "attr": "items"}}, "body": [{"step": "s003"}, {"step": "s005"}, {"step": "s006"}, {"step": "s007"}, {"step": "s008"}, {"step": "s009"}, {"step": "s015"}, {"step": "s017"}]},
        "s003": {"op": "If", "test": {"op": "BoolOp", "operator": {"op": "Or"}, "values": [{"op": "Compare", "left": {"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "relation"}}, "ops": [{"op": "NotIn"}], "comparators": [{"op": "Subscript", "value": {"name": "rules"}, "slice": {"const": "relations"}}]}, {"op": "UnaryOp", "operator": {"op": "Not"}, "operand": {"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "when"}}}]}, "body": [{"step": "s004"}]},
        "s004": {"op": "Raise", "exc": {"op": "Call", "func": {"name": "ValueError"}, "args": [{"op": "JoinedStr", "values": [{"const": "Default "}, {"op": "FormattedValue", "value": {"name": "name"}, "conversion": 114}, {"const": " needs a relation and at least one premise."}]}]}},
        "s005": {"op": "Assign", "targets": [{"store": "bound"}], "value": {"op": "Call", "func": {"op": "Attribute", "value": {"op": "Call", "func": {"name": "set"}}, "attr": "union"}, "args": [{"op": "Starred", "value": {"op": "GeneratorExp", "elt": {"op": "Call", "func": {"body": "body/vault_reasoning/fact_variables"}, "args": [{"name": "premise"}]}, "generators": [{"op": "comprehension", "target": {"store": "premise"}, "iter": {"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "when"}}, "is_async": 0}]}}]}},
        "s006": {"op": "Assign", "targets": [{"store": "output"}], "value": {"op": "Call", "func": {"body": "body/vault_reasoning/fact_variables"}, "args": [{"op": "Subscript", "value": {"name": "rule"}, "slice": {"const": "expect"}}], "keywords": [{"op": "keyword", "arg": "allow_negation", "value": {"const": false}}]}},
        "s007": {"op": "Assign", "targets": [{"store": "exceptions"}], "value": {"op": "Call", "func": {"op": "Attribute", "value": {"op": "Call", "func": {"name": "set"}}, "attr": "union"}, "args": [{"op": "Starred", "value": {"op": "GeneratorExp", "elt": {"op": "Call", "func": {"body": "body/vault_reasoning/fact_variables"}, "args": [{"name": "fact"}]}, "generators": [{"op": "comprehension", "target": {"store": "fact"}, "iter": {"op": "Call", "func": {"op": "Attribute", "value": {"name": "rule"}, "attr": "get"}, "args": [{"const": "unless"}, {"op": "List"}]}, "is_async": 0}]}}]}},
