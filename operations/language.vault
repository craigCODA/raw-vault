          "known": {},
          "alternatives": [
            {
              "time": "morning",
              "color": "green",
              "outcome": "bus"
            },
            {
              "time": "afternoon",
              "color": "green",
              "outcome": "train"
            }
          ]
        },
        "expect": {
          "field": "time",
          "question": "What time do you plan to travel?"
        }
      },
      {
        "name": "same-outcome",
        "input": {
          "known": {},
          "alternatives": [
            {
              "time": "morning",
              "color": "green",
              "outcome": "bus"
            },
            {
              "time": "afternoon",
              "color": "blue",
              "outcome": "bus"
            }
          ]
        },
        "expect": {
          "field": null,
          "question": null
        }
      }
    ]
  },
  {
    "id": 16,
    "name": "indirect-requests",
    "title": "Indirect requests",
    "operator": "indirect",
    "parameters": {
      "request_label": "request",
      "default_label": "statement",
      "rules": [
        {
          "setting": "shared room",
          "intent": "warmer room",
          "cues": [
            "cold",
            "here"
          ],
          "action": "close the window"
        }
      ]
    },
    "anchors": [
      "request",
      "window"
    ],
    "cases": [
      {
        "name": "shared-room",
        "input": {
          "utterance": "It is cold in here.",
          "setting": "shared room",
          "intent": "warmer room"
        },
        "expect": {
          "act": "request",
          "action": "close the window"
        }
      },
      {
        "name": "temperature-report",
        "input": {
          "utterance": "It is cold in here.",
          "setting": "shared room",
          "intent": "record temperature"
        },
        "expect": {
          "act": "statement",
          "action": null
        }
      }
    ]
  },
  {
    "id": 17,
    "name": "commitments",
    "title": "Commitments",
    "operator": "commitment",
    "parameters": {
      "initial": "none",
      "transitions": {
        "none": {
          "offer": "offered"
        },
        "offered": {
          "accept": "accepted",
          "decline": "declined"
        },
        "accepted": {
          "become due": "due",
          "fulfill": "fulfilled"
        },
        "due": {
          "fulfill": "fulfilled"
        }
      }
    },
    "anchors": [
      "promise",
      "commitment"
    ],
    "cases": [
      {
        "name": "completed-commitment",
        "input": {
          "events": [
            {
              "event": "offer"
            },
            {
              "event": "accept"
            },
            {
              "event": "become due"
            },
            {
              "event": "fulfill"
            }
          ]
        },
        "expect": {
          "state": "fulfilled",
          "history": [
            "offered",
            "accepted",
            "due",
            "fulfilled"
          ]
        }
      },
      {
        "name": "offer-declined",
        "input": {
          "events": [
            {
              "event": "offer"
            },
            {
              "event": "decline"
            }
          ]
        },
        "expect": {
          "state": "declined",
          "history": [
            "offered",
            "declined"
          ]
        }
      }
    ]
  },
  {
    "id": 18,
    "name": "corrections",
    "title": "Corrections",
    "operator": "correction",
    "parameters": {
      "identity": [
        "subject",
        "scope"
      ],
      "editable": [
        "color",
        "time"
      ]
    },
    "anchors": [
      "fact",
      "history"
    ],
    "cases": [
      {
        "name": "update-one-scope",
        "input": {
          "facts": [
            {
              "subject": "cup",
              "scope": "kitchen",
              "color": "red"
            },
            {
              "subject": "cup",
              "scope": "office",
              "color": "red"
            }
          ],
          "correction": {
            "subject": "cup",
            "scope": "kitchen",
            "field": "color",
            "value": "blue"
          }
        },
        "expect": {
          "facts": [
            {
              "subject": "cup",
              "scope": "kitchen",
              "color": "blue"
            },
            {
              "subject": "cup",
              "scope": "office",
              "color": "red"
            }
          ],
          "history": [
            {
              "subject": "cup",
              "scope": "kitchen",
              "field": "color",
              "before": "red",
              "after": "blue"
            }
          ]
        }
      }
    ]
  },
  {
    "id": 19,
    "name": "topic-return",
    "title": "Topic return",
    "operator": "topic",
    "parameters": {
      "leave": "leave",
      "resume": "resume"
    },
    "anchors": [
      "topic",
      "history"
    ],
    "cases": [
      {
        "name": "return-to-first-branch",
        "input": {
          "initial": "garden",
          "moves": [
            {
              "type": "leave",
              "topic": "dinner",
              "checkpoint": {
                "open": "watering time"
              }
            },
            {
              "type": "leave",
              "topic": "travel",
              "checkpoint": {
                "open": "guest count"
              }
            },
            {
              "type": "resume",
              "topic": "garden"
            }
          ]
        },
        "expect": {
          "topic": "garden",
          "checkpoint": {
            "open": "watering time"
          },
          "bookmarks": {
            "dinner": {
              "open": "guest count"
            }
          }
        }
      }
    ]
  },
  {
    "id": 20,
    "name": "reply-structure",
    "title": "Reply structure",
    "operator": "reply",
    "parameters": {
      "formats": {
        "answer": {
          "fields": [
            "conclusion"
          ],
          "template": "{conclusion}"
        },
        "example": {
          "fields": [
            "conclusion",
            "example"
          ],
          "template": "{conclusion} For example, {example}"
        },
        "proof": {
          "fields": [
            "proof",
            "conclusion"
          ],
          "template": "{proof} Therefore, {conclusion}"
        },
        "explanation": {
          "fields": [
            "conclusion",
            "reason"
          ],
          "template": "{conclusion} {reason}"
        }
      }
    },
    "anchors": [
      "reply",
      "answer"
    ],
    "cases": [
      {
        "name": "example",
        "input": {
          "format": "example",
          "conclusion": "The shelter is open.",
          "evidence": {
            "example": "A traveler entered at noon.",
            "proof": "The signed schedule lists today's hours.",
            "reason": "It is within posted hours."
          }
        },
        "expect": {
          "missing": [],
          "text": "The shelter is open. For example, A traveler entered at noon."
        }
      },
      {
        "name": "proof",
        "input": {
          "format": "proof",
          "conclusion": "The shelter is open.",
          "evidence": {
            "example": "A traveler entered at noon.",
            "proof": "The signed schedule lists today's hours.",
            "reason": "It is within posted hours."
          }
        },
        "expect": {
          "missing": [],
          "text": "The signed schedule lists today's hours. Therefore, The shelter is open."
        }
      }
    ]
  },
