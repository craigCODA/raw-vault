[
  {
    "id": 1,
    "name": "word-senses",
    "title": "Word senses",
    "operator": "sense",
    "parameters": {
      "words": {
        "bank": {
          "financial": [
            "loan",
            "deposit",
            "account"
          ],
          "river": [
            "river",
            "water",
            "shore"
          ]
        }
      }
    },
    "anchors": [
      "bank",
      "money",
      "river"
    ],
    "cases": [
      {
        "name": "river",
        "input": {
          "word": "bank",
          "context": "They walked along the river where water met the shore."
        },
        "expect": {
          "sense": "river",
          "scores": {
            "river": 3,
            "financial": 0
          }
        }
      },
      {
        "name": "financial",
        "input": {
          "word": "Bank",
          "context": "Deposit the check into my account."
        },
        "expect": {
          "sense": "financial"
        }
      }
    ]
  },
  {
    "id": 2,
    "name": "reference-resolution",
    "title": "Reference resolution",
    "operator": "reference",
    "parameters": {
      "references": {
        "she": {
          "number": "singular",
          "kind": "person"
        },
        "it": {
          "number": "singular",
          "kind": "thing"
        },
        "they": {
          "number": "plural"
        }
      }
    },
    "anchors": [
      "reference",
      "person"
    ],
    "cases": [
      {
        "name": "pronoun",
        "input": {
          "reference": "she",
          "mentions": [
            {
              "id": "box",
              "position": 0,
              "number": "singular",
              "kind": "thing"
            },
            {
              "id": "mira",
              "position": 1,
              "number": "singular",
              "kind": "person"
            },
            {
              "id": "birds",
              "position": 2,
              "number": "plural",
              "kind": "animal"
            }
          ]
        },
        "expect": {
          "antecedent": "mira"
        }
      },
      {
        "name": "description",
        "input": {
          "reference": "the container",
          "attributes": {
            "kind": "thing"
          },
          "mentions": [
            {
              "id": "box",
              "position": 0,
              "number": "singular",
              "kind": "thing"
            },
            {
              "id": "mira",
              "position": 1,
              "number": "singular",
              "kind": "person"
            },
            {
              "id": "birds",
              "position": 2,
              "number": "plural",
              "kind": "animal"
            }
          ]
        },
        "expect": {
          "antecedent": "box"
        }
      }
    ]
  },
  {
    "id": 3,
    "name": "here-there-and-now",
    "title": "Here, there, and now",
    "operator": "deixis",
    "parameters": {
      "sources": {
        "I": "speaker",
        "you": "listener",
        "here": "place",
        "there": "pointed_place",
        "now": "instant",
        "today": "date"
      },
      "days": {
        "yesterday": -1,
        "tomorrow": 1
      }
    },
    "anchors": [
      "speaker",
      "place",
      "time"
    ],
    "cases": [
      {
        "name": "speaker-place-and-date",
        "input": {
          "tokens": [
            "I",
            "here",
            "there",
            "now",
            "tomorrow"
          ],
          "setting": {
            "speaker": "Mira",
            "place": "kitchen",
            "pointed_place": "garden",
            "instant": "2028-02-29T16:30:00Z",
            "date": "2028-02-29"
          }
        },
        "expect": {
          "I": "Mira",
          "here": "kitchen",
          "there": "garden",
          "now": "2028-02-29T16:30:00Z",
          "tomorrow": "2028-03-01"
        }
      }
    ]
  },
  {
    "id": 4,
    "name": "semantic-roles",
    "title": "Semantic roles",
    "operator": "event",
    "parameters": {
      "templates": [
        {
          "pattern": "(?P<agent>\\w+) gave (?P<theme>.+?) to (?P<recipient>\\w+)",
          "event": "give"
        },
        {
          "pattern": "(?P<agent>\\w+) opened (?P<patient>.+?) with (?P<instrument>.+)",
          "event": "open"
        }
      ]
    },
    "anchors": [
      "event",
      "give"
    ],
    "cases": [
      {
        "name": "transfer",
        "input": {
          "sentence": "Mira gave a blue cup to Lee."
        },
        "expect": {
          "event": "give",
          "roles": {
            "agent": "mira",
            "recipient": "lee",
            "theme": "a blue cup"
          }
        }
      },
      {
        "name": "instrument",
        "input": {
          "sentence": "Lee opened the box with a key."
        },
        "expect": {
          "event": "open",
          "roles": {
            "instrument": "a key",
            "patient": "the box",
            "agent": "lee"
          }
        }
      }
    ]
  },
  {
    "id": 5,
    "name": "paraphrase",
    "title": "Paraphrase",
    "operator": "event",
    "parameters": {
      "templates": [
        {
          "pattern": "(?P<agent>\\w+) gave (?P<theme>.+?) to (?P<recipient>\\w+)",
          "event": "give"
        },
        {
          "pattern": "(?P<theme>.+?) was given to (?P<recipient>\\w+) by (?P<agent>\\w+)",
          "event": "give"
        }
      ]
    },
    "anchors": [
      "sentence",
      "meaning"
    ],
    "cases": [
      {
        "name": "active",
        "input": {
          "sentence": "Mira gave a blue cup to Lee."
        },
        "expect": {
          "event": "give",
          "roles": {
            "agent": "mira",
            "recipient": "lee",
            "theme": "a blue cup"
          }
        }
      },
      {
        "name": "passive",
        "input": {
          "sentence": "A blue cup was given to Lee by Mira."
        },
        "expect": {
          "event": "give",
          "roles": {
            "agent": "mira",
            "recipient": "lee",
            "theme": "a blue cup"
          }
        }
      }
    ]
  },
  {
    "id": 6,
    "name": "phrase-composition",
    "title": "Phrase composition",
    "operator": "compound",
    "parameters": {
      "relations": {
        "purpose": "{head} for {modifier}",
        "material": "{head} made of {modifier}",
        "location": "{head} found in {modifier}"
      }
    },
    "anchors": [
      "phrase",
      "word"
    ],
    "cases": [
      {
        "name": "new-purpose-compound",
        "input": {
          "parts": [
            "night",
            "garden",
            "lamp"
          ],
          "relation": "purpose"
        },
        "expect": {
          "head": "lamp",
          "modifier": "night garden",
          "gloss": "lamp for night garden"
        }
      },
      {
        "name": "new-material-compound",
        "input": {
          "parts": [
            "bamboo",
            "shelf"
          ],
          "relation": "material"
        },
        "expect": {
          "gloss": "shelf made of bamboo"
        }
      }
    ]
  },
  {
    "id": 7,
    "name": "idioms",
    "title": "Idioms",
    "operator": "idiom",
    "parameters": {
      "idioms": {
        "break the ice": {
          "conventional": {
            "cues": [
              "party",
              "conversation",
              "strangers"
            ],
            "meaning": "ease social tension"
          },
          "literal": {
            "cues": [
              "frozen",
              "lake",
              "hammer"
            ],
            "meaning": "fracture frozen water"
          }
        }
      }
    },
    "anchors": [
      "phrase",
      "ice"
    ],
    "cases": [
      {
        "name": "social",
        "input": {
          "phrase": "break the ice",
          "context": "Strangers at the party needed a way to start a conversation."
        },
        "expect": {
          "reading": "conventional",
          "meaning": "ease social tension"
        }
      },
      {
        "name": "physical",
        "input": {
          "phrase": "break the ice",
          "context": "She carried a hammer onto the frozen lake."
        },
        "expect": {
          "reading": "literal",
          "meaning": "fracture frozen water"
        }
      }
    ]
  },
  {
    "id": 8,
    "name": "negation-scope",
    "title": "Negation scope",
    "operator": "negation",
    "parameters": {
      "polarity_field": "affirmed"
    },
    "anchors": [
      "deny",
      "sentence"
    ],
    "cases": [
      {
        "name": "embedded-denial",
        "input": {
          "statement": {
            "predicate": "say",
            "affirmed": true,
            "content": {
              "predicate": "leave",
              "agent": "lee"
            },
            "speaker": "mira"
          },
          "scope": [
            "content"
          ]
        },
        "expect": {
          "predicate": "say",
          "affirmed": true,
          "content": {
            "predicate": "leave",
            "agent": "lee",
            "affirmed": false
          },
          "speaker": "mira"
        }
      }
    ]
  },
  {
    "id": 9,
    "name": "presuppositions",
    "title": "Presuppositions",
    "operator": "presuppositions",
    "parameters": {
      "triggers": [
        {
          "pattern": "when did (?P<person>\\w+) stop (?P<activity>.+)",
          "predicate": "previously_did"
        },
        {
          "pattern": "where did (?P<person>\\w+) find (?P<object>.+)",
          "predicate": "found"
        }
      ]
    },
    "anchors": [
      "question",
      "fact"
    ],
    "cases": [
      {
        "name": "stop-question",
        "input": {
          "sentence": "When did Mira stop skating?"
        },
        "expect": {
          "presupposed": [
            {
              "predicate": "previously_did",
              "roles": {
                "person": "mira",
                "activity": "skating"
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": 10,
    "name": "crosslanguage-meaning",
    "title": "Cross-language meaning",
    "operator": "translate",
    "parameters": {
      "variants": {
        "en": {
          "the sky is blue": "sky_blue"
        },
        "es": {
          "el cielo es azul": "sky_blue"
        },
        "fr": {
          "le ciel est bleu": "sky_blue"
        }
      },
      "facts": {
        "sky_blue": {
          "subject": "sky",
          "property": "color",
          "value": "blue"
        }
      }
    },
    "anchors": [
      "language",
      "meaning"
    ],
    "cases": [
      {
        "name": "spanish",
        "input": {
          "language": "es",
          "sentence": "El cielo es azul."
        },
        "expect": {
          "fact": {
            "subject": "sky",
            "property": "color",
            "value": "blue"
          }
        }
      },
      {
        "name": "french",
        "input": {
          "language": "fr",
          "sentence": "Le ciel est bleu."
        },
        "expect": {
          "fact": {
            "subject": "sky",
            "property": "color",
            "value": "blue"
          }
        }
      }
    ]
  },
  {
    "id": 11,
    "name": "speech-acts",
    "title": "Speech acts",
    "operator": "speech_act",
    "parameters": {
      "patterns": [
        {
          "route": "ask",
          "pattern": "where is (?P<subject>.+)"
        },
        {
          "route": "request",
          "pattern": "please (?P<subject>.+)"
        },
        {
          "route": "promise",
          "pattern": "i promise to (?P<subject>.+)"
        },
        {
          "route": "offer",
          "pattern": "i can offer (?P<subject>.+)"
        },
        {
          "route": "object",
          "pattern": "i object to (?P<subject>.+)"
        },
        {
          "route": "correct",
          "pattern": "actually, (?P<subject>.+)"
        }
      ]
    },
    "anchors": [
      "promise",
      "request"
    ],
    "cases": [
      {
        "name": "promise",
        "input": {
          "utterance": "I promise to call Lee."
        },
        "expect": {
          "act": "promise",
          "subject": "call Lee"
        }
      },
      {
        "name": "correction",
        "input": {
          "utterance": "Actually, the door is open."
        },
        "expect": {
          "act": "correct",
          "subject": "the door is open"
        }
      }
    ]
  },
  {
    "id": 12,
    "name": "intent",
    "title": "Intent",
    "operator": "intent",
    "parameters": {
      "patterns": [
        {
          "route": "explanation",
          "pattern": "why (?P<subject>.+)"
        },
        {
          "route": "answer",
          "pattern": "what is (?P<subject>.+)"
        },
        {
          "route": "decision",
          "pattern": "choose (?P<subject>.+)"
        },
        {
          "route": "action",
          "pattern": "please (?P<subject>.+)"
        }
      ],
      "fields": {
        "answer": [
          "value"
        ],
        "explanation": [
          "conclusion",
          "reason"
        ],
        "decision": [
          "options",
          "criteria"
        ],
        "action": [
          "verb",
          "object"
        ]
      }
    },
    "anchors": [
      "intention",
      "answer"
    ],
    "cases": [
      {
        "name": "explain",
        "input": {
          "utterance": "Why did the timer ring?"
        },
        "expect": {
          "intent": "explanation",
          "goal": "did the timer ring",
          "fields": [
            "conclusion",
            "reason"
          ]
        }
      },
      {
        "name": "decide",
        "input": {
          "utterance": "Choose a route."
        },
        "expect": {
          "intent": "decision",
          "goal": "a route",
          "fields": [
            "options",
            "criteria"
          ]
        }
      }
    ]
  },
  {
    "id": 13,
    "name": "constraints",
    "title": "Constraints",
    "operator": "constrain",
    "parameters": {
      "constraints": {
        "just the name": {
          "fields": [
            "name"
          ],
          "limit": 1
        },
        "names and dates": {
          "fields": [
            "name",
            "date"
          ]
        }
      }
    },
    "anchors": [
      "name",
      "information"
    ],
    "cases": [
      {
        "name": "single-name",
        "input": {
          "constraint": "just the name",
          "results": [
            {
              "name": "Mira",
              "date": "Monday",
              "age": 31
            },
            {
              "name": "Lee",
              "age": 46
            }
          ]
        },
        "expect": [
          {
            "name": "Mira"
          }
        ]
      },
      {
        "name": "date-list",
        "input": {
          "constraint": "names and dates",
          "results": [
            {
              "name": "Mira",
              "date": "Monday",
              "age": 31
            },
            {
              "name": "Lee",
              "date": "Friday",
              "age": 46
            }
          ]
        },
        "expect": [
          {
            "name": "Mira",
            "date": "Monday"
          },
          {
            "name": "Lee",
            "date": "Friday"
          }
        ]
      }
    ]
  },
  {
    "id": 14,
    "name": "missing-information",
    "title": "Missing information",
    "operator": "missing",
    "parameters": {
      "required": {
        "delivery": [
          "recipient",
          "address",
          "item"
        ],
        "booking": [
          "date",
          "time",
          "party_size"
        ]
      }
    },
    "anchors": [
      "question",
      "information"
    ],
    "cases": [
      {
        "name": "unresolved-address",
        "input": {
          "operation": "delivery",
          "values": {
            "recipient": "Mira",
            "item": "book",
            "address": ""
          }
        },
        "expect": {
          "missing": [
            "address"
          ]
        }
      }
    ]
  },
  {
    "id": 15,
    "name": "clarification",
    "title": "Clarification",
    "operator": "clarify",
    "parameters": {
      "questions": [
        {
          "field": "color",
          "priority": 1,
          "question": "What color?"
        },
        {
          "field": "time",
          "priority": 2,
          "question": "What time do you plan to travel?"
        }
      ]
    },
    "anchors": [
      "question",
      "choice"
    ],
    "cases": [
      {
        "name": "outcome-changing-field",
