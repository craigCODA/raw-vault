            "orbits",
            "moon",
            "planet"
          ],
          "relations": {
            "orbits": "revolves-around"
          },
          "correspondence": {
            "moon": "electron",
            "planet": "nucleus"
          }
        },
        "expect": {
          "mapped": true,
          "target": [
            "revolves-around",
            "electron",
            "nucleus"
          ]
        }
      },
      {
        "name": "map requires each source role",
        "input": {
          "source": [
            "contains",
            "bag",
            "book"
          ],
          "relations": {
            "contains": "stores"
          },
          "correspondence": {
            "bag": "shelf"
          }
        },
        "expect": {
          "mapped": false,
          "missing_relation": false,
          "missing_roles": [
            "book"
          ]
        }
      }
    ]
