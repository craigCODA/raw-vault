  {
    "id": 51,
    "name": "counterfactuals",
    "title": "Counterfactuals",
    "operator": "compare_counterfactual",
    "parameters": {},
    "anchors": [
      "condition",
      "consequence"
    ],
    "cases": [
      {
        "name": "remove enabling fact",
        "input": {
          "state": {
            "key": true,
            "door": "closed"
          },
          "change": {
            "key": "key",
            "value": false
          },
          "consequence": {
            "all": [
              {
                "path": "key",
                "value": true
              },
              {
                "path": "door",
                "value": "closed"
              }
            ]
          }
        },
        "expect": {
          "actual": true,
          "hypothetical": false,
          "changed": true
        }
      },
      {
        "name": "change an unrelated fact",
        "input": {
          "state": {
            "key": true,
            "door": "closed"
          },
          "change": {
            "key": "color",
            "value": "red"
          },
          "consequence": {
            "path": "key",
            "value": true
          }
        },
        "expect": {
          "actual": true,
          "hypothetical": true,
          "changed": false
        }
      }
    ]
  },
